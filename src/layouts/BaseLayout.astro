---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import verein from '../data/verein.json';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'RSV „Schwalbe" Ellmendingen e. V. – Der Radsportverein in Baden. Mit Tradition und Leidenschaft für den Radsport seit über 125 Jahren.',
  ogImage = '/images/home/Amateure1.webp'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.rsv-ellmendingen.de');
const ogImageURL = new URL(ogImage, Astro.site || 'https://www.rsv-ellmendingen.de');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: verein.name,
  alternateName: verein.shortName,
  foundingDate: String(verein.founded),
  url: 'https://www.rsv-ellmendingen.de',
  logo: 'https://www.rsv-ellmendingen.de/Logo.svg',
  sport: 'Cycling',
  email: verein.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: verein.address.street,
    postalCode: verein.address.zip,
    addressLocality: verein.address.city,
    addressCountry: 'DE'
  },
  sameAs: [
    verein.social.facebook,
    verein.social.instagram
  ]
};
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalURL}>
  <meta name="theme-color" content="#FA006C">

  <!-- Open Graph / Social Sharing -->
  <meta property="og:locale" content="de_DE">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="RSV Schwalbe Ellmendingen e. V.">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:image" content={ogImageURL}>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="sitemap" href="/sitemap.xml">
  <link rel="preload" href="/fonts/ZalandoSans-Variable.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/ZalandoSansExpanded-Variable.woff2" as="font" type="font/woff2" crossorigin>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a href="#main-content" class="skip-link">Zum Hauptinhalt springen</a>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
</body>
</html>
