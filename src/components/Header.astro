---
import fs from 'node:fs';
import path from 'node:path';

const currentPath = Astro.url.pathname;

const rawSvg = fs.readFileSync(path.resolve('./public/Logo.svg'), 'utf-8')
  .replace(/<\?xml[^>]*\?>\s*/i, '')
  .replace(/fill:\s*#231f20;/g, 'fill: currentColor;');

function isActive(href: string) {
  if (href === '/') return currentPath === '/' || currentPath === '/index.html';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="site-logo">
      <span class="logo-icon" aria-hidden="true" set:html={rawSvg} />
      <span>RSV Schwalbe Ellmendingen</span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Hauptnavigation">
      <ul>
        <li><a href="/" class={isActive('/') ? 'active' : ''}>Start</a></li>
        <li>
          <button type="button" class="nav-toggle" aria-expanded="false">
            <span>Verein</span>
            <svg class="nav-caret" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul class="dropdown">
            <li><a href="/verein" class={isActive('/verein') ? 'active' : ''}>Der Verein</a></li>
            <li><a href="/sponsoren" class={isActive('/sponsoren') ? 'active' : ''}>Sponsoren</a></li>
            <li><a href="/wandergruppe" class={isActive('/wandergruppe') ? 'active' : ''}>Wandergruppe</a></li>
            <li><a href="/kontakt" class={isActive('/kontakt') ? 'active' : ''}>Kontakt</a></li>
          </ul>
        </li>
        <li>
          <button type="button" class="nav-toggle" aria-expanded="false">
            <span>Radsport</span>
            <svg class="nav-caret" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul class="dropdown">
            <li><a href="/fahrer" class={isActive('/fahrer') ? 'active' : ''}>Fahrer</a></li>
            <li><a href="/rsv-kids" class={isActive('/rsv-kids') ? 'active' : ''}>RSV-Kids</a></li>
            <li><a href="/training" class={isActive('/training') ? 'active' : ''}>Training &amp; Ausfahrten</a></li>
          </ul>
        </li>
        <li><a href="/veranstaltungen" class={isActive('/veranstaltungen') ? 'active' : ''}>Veranstaltungen</a></li>
        <li>
          <button type="button" class="nav-toggle" aria-expanded="false">
            <span>Mehr</span>
            <svg class="nav-caret" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul class="dropdown">
            <li><a href="/bilder" class={isActive('/bilder') ? 'active' : ''}>Bilder</a></li>
            <li><a href="/links" class={isActive('/links') ? 'active' : ''}>Links</a></li>
            <li><a href="/archiv" class={isActive('/archiv') ? 'active' : ''}>Archive</a></li>
          </ul>
        </li>
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/mitglied-werden" class="btn-header-cta">Mitglied werden</a>
      <button type="button" class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Menü öffnen" aria-expanded="false" aria-controls="site-nav">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  function initHeaderNav() {
    const nav = document.getElementById('site-nav');
    const mobileBtn = document.getElementById('mobile-menu-toggle');
    const items = document.querySelectorAll<HTMLLIElement>('.site-nav > ul > li');
    const desktopQuery = window.matchMedia('(min-width: 960px)');

    function closeAllDropdowns(except?: HTMLLIElement) {
      items.forEach((li) => {
        if (li !== except) {
          li.classList.remove('open');
          li.querySelector('.nav-toggle')?.setAttribute('aria-expanded', 'false');
        }
      });
    }

    function closeMobileMenu() {
      nav?.classList.remove('is-open');
      mobileBtn?.setAttribute('aria-expanded', 'false');
      mobileBtn?.setAttribute('aria-label', 'Menü öffnen');
    }

    mobileBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = nav?.classList.toggle('is-open') ?? false;
      mobileBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      mobileBtn.setAttribute('aria-label', isOpen ? 'Menü schließen' : 'Menü öffnen');
      if (!isOpen) closeAllDropdowns();
    });

    items.forEach((li) => {
      const toggle = li.querySelector<HTMLButtonElement>('.nav-toggle');
      const dropdown = li.querySelector<HTMLElement>('.dropdown');
      if (!toggle || !dropdown) return;

      let closeTimer: ReturnType<typeof setTimeout> | null = null;

      function openMenu() {
        if (closeTimer) clearTimeout(closeTimer);
        closeAllDropdowns(li);
        li.classList.add('open');
        toggle!.setAttribute('aria-expanded', 'true');
      }

      function scheduleClose() {
        if (!desktopQuery.matches) return;
        closeTimer = setTimeout(() => {
          li.classList.remove('open');
          toggle!.setAttribute('aria-expanded', 'false');
        }, 120);
      }

      li.addEventListener('mouseenter', () => {
        if (desktopQuery.matches) openMenu();
      });

      li.addEventListener('mouseleave', () => {
        if (desktopQuery.matches) scheduleClose();
      });

      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        if (li.classList.contains('open')) {
          li.classList.remove('open');
          toggle.setAttribute('aria-expanded', 'false');
        } else {
          openMenu();
        }
      });
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      closeAllDropdowns();
      if (nav && !nav.contains(target) && mobileBtn && !mobileBtn.contains(target)) {
        closeMobileMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllDropdowns();
        closeMobileMenu();
      }
    });
  }

  initHeaderNav();
</script>

