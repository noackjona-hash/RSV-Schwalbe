---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('berichte');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | RSV Schwalbe Ellmendingen`} description={post.data.excerpt}>
  <div class="article-page-wrap">
    <article class="article">
      <h1>{post.data.title}</h1>
      <p class="article-meta">
        {post.data.date}{post.data.category ? ` · ${post.data.category}` : ''}
      </p>

      {post.data.images && post.data.images.length > 0 && (
        <>
          <div class="article-photo-grid">
            {post.data.images.slice(0, 3).map((img) => (
              <div class="article-photo-item">
                <img src={img.src} alt={img.alt} width="400" height="400" loading="eager" decoding="async" />
              </div>
            ))}
          </div>
          {post.data.images.length > 3 && (
            <ImageGallery images={post.data.images} id="gallery-1" />
          )}
        </>
      )}

      <div class="article-body">
        <Content />
      </div>

      <a href={post.data.showInOverview ? '/berichte' : '/'} class="btn-back">
        Zurück zur Übersicht
      </a>
    </article>
  </div>
</BaseLayout>
