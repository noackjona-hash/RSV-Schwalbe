---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allBerichte = await getCollection('berichte', ({ data }) => data.showInOverview);
const sortedBerichte = allBerichte.sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout
  title="Alle Berichte | RSV Schwalbe Ellmendingen"
  description="Aktuelle Vereinsberichte, Rennrückblicke, Jugendnachrichten und Meldungen des RSV Schwalbe Ellmendingen e. V."
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'Berichte', url: '/berichte' }
  ]}
>
  <div class="page-body">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/">Startseite</a></li>
          <li aria-current="page">Berichte</li>
        </ol>
      </nav>
      <h1>Berichte</h1>
      <p>Neuigkeiten aus dem Vereinsleben, von den Rennstrecken und unseren Gruppen.</p>

      <div class="berichte-list">
        {sortedBerichte.map((post) => (
          <article class="bericht-row">
            {post.data.thumbnail && (
              <a href={`/blog/${post.slug}`} class="bericht-thumb" tabindex="-1" aria-hidden="true">
                <img src={post.data.thumbnail} alt="" width="220" height="220" loading="lazy" decoding="async" />
              </a>
            )}
            <div class="bericht-content">
              <div class="news-meta">
                {post.data.dateDisplay}{post.data.category ? ` · ${post.data.category}` : ''}
              </div>
              <h2><a href={`/blog/${post.slug}`}>{post.data.title}</a></h2>
              <p>{post.data.excerpt}</p>
              <a href={`/blog/${post.slug}`} class="read-more">
                <span>Weiterlesen<span class="sr-only"> zu &bdquo;{post.data.title}&ldquo;</span></span>
                <span class="btn-arrow" aria-hidden="true">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

