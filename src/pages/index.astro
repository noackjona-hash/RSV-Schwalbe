---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import sponsoren from '../data/sponsoren.json';
import galerie from '../data/galerie.json';

const allTermine = await getCollection('veranstaltungen');
const sortedTermine = allTermine.sort((a, b) => a.data.date.localeCompare(b.data.date));

const allBerichte = await getCollection('berichte', ({ data }) => data.showOnHome);
const sortedBerichte = allBerichte.sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout title="RSV Schwalbe Ellmendingen | Der Radsportverein in Baden">
  <!-- HERO (Exakt nach RSV-Corporate-Design.pdf Seite 2, LCP-optimiertes <img> statt CSS background-image) -->
  <section class="hero">
    <img
      src="/images/home/hero.webp"
      alt=""
      width="1280"
      height="720"
      fetchpriority="high"
      decoding="async"
      class="hero-bg-img"
      aria-hidden="true"
    />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container hero-content">
      <span class="hero-badge">RSV Schwalbe Ellmendingen e.&thinsp;V. · Seit 1897</span>
      <h1>Der Radsportverein in Baden</h1>
      <p>Mit Tradition und Leidenschaft für den Radsport seit über 125 Jahren.</p>
      <div class="hero-buttons">
        <a href="/mitglied-werden" class="btn btn-yellow">Mitglied werden</a>
        <a href="/training" class="btn btn-secondary">Training &amp; Ausfahrten</a>
      </div>
    </div>
  </section>

  <!-- 1. NEUES AUS DEM VEREIN (Exakt nach RSV-Corporate-Design.pdf Seite 2) -->
  <section class="section">
    <div class="container">
      <div class="section-header-center">
        <h2>Neues aus dem Verein</h2>
      </div>
      <div class="news-grid">
        {sortedBerichte.map((post) => (
          <article class="news-card">
            {post.data.thumbnail && (
              <a href={`/blog/${post.slug}`} class="news-card-thumb" tabindex="-1" aria-hidden="true">
                <img
                  src={post.data.thumbnail}
                  alt={post.data.title}
                  width="220"
                  height="220"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )}
            <div class="news-card-body">
              <h3><a href={`/blog/${post.slug}`}>{post.data.title}</a></h3>
              <div class="news-meta">{post.data.date}</div>
              <a href={`/blog/${post.slug}`} class="read-more" aria-label={`Weiterlesen: ${post.data.title}`}>
                Weiterlesen
              </a>
            </div>
          </article>
        ))}
      </div>
      <div class="section-footer-action">
        <a href="/berichte" class="view-all">Alle Vereinsberichte ansehen &rarr;</a>
      </div>
    </div>
  </section>

  <!-- 2. NÄCHSTE VERANSTALTUNGEN (Exakt nach RSV-Corporate-Design.pdf Seite 2 & 6) -->
  <section class="section-alt">
    <div class="container">
      <div class="section-header-center">
        <h2>Nächste Veranstaltungen</h2>
      </div>
      <div class="termine-grid">
        {sortedTermine.map((termin) => (
          <a href={termin.data.detailUrl} class="termin-card">
            <div>
              <span class="termin-kicker">
                {termin.data.highlight ? 'Radrennen · Highlight' : 'Veranstaltung'}
              </span>
              <h3>{termin.data.title}</h3>
            </div>
            <div class="termin-meta-row">
              <span class="termin-meta-item">
                <svg class="termin-meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                {termin.data.date}
              </span>
              <span class="termin-meta-item">
                <svg class="termin-meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                {termin.data.subtitle}
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- Plakat-Highlight im Corporate Design (Seite 6 des Design-Guides) -->
      <div class="poster-banner">
        <span class="poster-kicker">14. Mai 2026</span>
        <h2>Radrennen &bdquo;Rund um die Alte Kelter&ldquo;</h2>
        <p>Das traditionsreiche Straßenrennen im Ortskern von Keltern-Ellmendingen – für Schüler, Jugend, Jedermänner und Amateure.</p>
        <a href="/veranstaltung-detail" class="btn btn-primary">Zum Programm &amp; Zeitplan</a>
      </div>
    </div>
  </section>

  <!-- 3. BILDER (Exakt nach RSV-Corporate-Design.pdf Seite 2) -->
  <section class="section">
    <div class="container">
      <div class="section-header-center">
        <h2>Bilder</h2>
      </div>
      <div class="gallery-home-grid">
        {galerie.homeTeaser.map((img) => (
          <a href="/bilder" class="gallery-item" aria-label={img.alt}>
            <img
              src={img.src}
              alt={img.alt}
              width="480"
              height="480"
              loading="lazy"
              decoding="async"
            />
          </a>
        ))}
      </div>
      <div class="gallery-cta-wrap">
        <a href="/bilder" class="btn btn-yellow">Alle Bilder ansehen</a>
      </div>
    </div>
  </section>

  <!-- 4. UNSERE SPONSOREN (Exakt nach RSV-Corporate-Design.pdf Seite 2) -->
  <section class="sponsoren-home">
    <div class="container">
      <h2>Unsere Sponsoren</h2>
      <div class="sponsoren-showcase">
        <div class="sponsoren-flex">
          {sponsoren.map((sponsor) => (
            <a href={sponsor.url} target="_blank" rel="noopener" class="sponsor-box" title={sponsor.name}>
              <img
                src={sponsor.logo}
                alt={sponsor.name}
                width="160"
                height="60"
                loading="lazy"
                decoding="async"
              />
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
