---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('veranstaltungen', 'jhv-2026');
const { Content } = await render(entry!);
---

<BaseLayout title="Jahreshauptversammlung 2026 | RSV Schwalbe Ellmendingen">
  <div class="article-page-wrap">
    <article class="article">
      <span class="termin-kicker">Veranstaltung</span>
      <h1>{entry!.data.title} {entry!.data.year}</h1>
      <p class="article-meta">{entry!.data.metaLine}</p>

      <div class="article-body">
        <Content />
      </div>

      <a href="/veranstaltungen" class="btn-back">Zurück zur Übersicht</a>
    </article>
  </div>
</BaseLayout>
