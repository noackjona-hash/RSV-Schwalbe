---
import BaseLayout from '../layouts/BaseLayout.astro';
import galerie from '../data/galerie.json';
import verein from '../data/verein.json';
---

<BaseLayout title="Bilder | RSV Schwalbe Ellmendingen">
  <div class="page-body">
    <div class="container">
      <h1>Bilder</h1>
      <p>Eindrücke von unseren Rennen, Trainingsausfahrten und dem Vereinsleben rund um den RSV &ldquo;Schwalbe&rdquo; Ellmendingen.</p>

      <div class="gallery-page-grid">
        {galerie.galleryPage.map((img, index) => (
          <button
            type="button"
            class="gallery-page-item gallery-lightbox-trigger"
            data-index={index}
            data-src={img.src}
            data-alt={img.alt}
            aria-label={`${img.alt} vergrößern`}
          >
            <img src={img.src} alt={img.alt} loading="lazy" />
          </button>
        ))}
      </div>

      <div style="margin-top: 3rem; padding: 2rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap;">
        <div>
          <h3 style="margin-bottom: 0.25rem;">Noch mehr Bilder auf Instagram</h3>
          <p style="margin-bottom: 0;">Aktuelle Impressionen von Rennen, Ausfahrten und dem Vereinsleben teilen wir regelmäßig auf unserem Instagram-Kanal.</p>
        </div>
        <a href={verein.social.instagram} target="_blank" rel="noopener" class="btn btn-primary" style="white-space: nowrap;">@rsv_schwalbe_ellmendingen &rarr;</a>
      </div>
    </div>
  </div>

  <div class="lightbox-backdrop" id="lightbox" aria-hidden="true" role="dialog" aria-label="Bildansicht">
    <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Schließen">&times;</button>
    <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Vorheriges Bild">&#10094;</button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="" />
    <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Nächstes Bild">&#10095;</button>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var triggers = Array.from(document.querySelectorAll('.gallery-lightbox-trigger'));
      var lightbox = document.getElementById('lightbox');
      var lightboxImg = document.getElementById('lightbox-img');
      var closeBtn = document.getElementById('lightbox-close');
      var prevBtn = document.getElementById('lightbox-prev');
      var nextBtn = document.getElementById('lightbox-next');
      if (!lightbox || !lightboxImg || triggers.length === 0) return;

      var currentIndex = 0;

      function showImage(index) {
        currentIndex = ((index % triggers.length) + triggers.length) % triggers.length;
        var item = triggers[currentIndex];
        lightboxImg.src = item.dataset.src || '';
        lightboxImg.alt = item.dataset.alt || '';
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
      }

      function closeLightbox() {
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
      }

      triggers.forEach(function (btn, idx) {
        btn.addEventListener('click', function () { showImage(idx); });
      });

      if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
      if (prevBtn) prevBtn.addEventListener('click', function (e) { e.stopPropagation(); showImage(currentIndex - 1); });
      if (nextBtn) nextBtn.addEventListener('click', function (e) { e.stopPropagation(); showImage(currentIndex + 1); });

      lightbox.addEventListener('click', function (e) {
        if (e.target === lightbox) closeLightbox();
      });

      document.addEventListener('keydown', function (e) {
        if (!lightbox.classList.contains('is-open')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
        if (e.key === 'ArrowRight') showImage(currentIndex + 1);
      });
    });
  </script>
</BaseLayout>
