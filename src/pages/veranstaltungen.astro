---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allTermine = await getCollection('veranstaltungen');
const sortedTermine = allTermine.sort((a, b) => a.data.date.localeCompare(b.data.date));
---

<BaseLayout title="Veranstaltungen | RSV Schwalbe Ellmendingen">
  <div class="page-body">
    <div class="container">
      <h1>Veranstaltungen &amp; Termine</h1>
      <p>Hier findest du alle anstehenden Vereinsveranstaltungen, Renntermine und Feste des RSV &ldquo;Schwalbe&rdquo; Ellmendingen e.&thinsp;V.</p>

      <h2>Termine 2026</h2>
      <div class="termine-grid" style="margin-top: 1.5rem; margin-bottom: 3rem;">
        {sortedTermine.map((termin) => (
          <a href={termin.data.detailUrl} class="termin-card">
            <div class="termin-date">
              <span class="day">{termin.data.day}</span>
              <span class="month">{termin.data.month}</span>
            </div>
            <div class="termin-info">
              <h3>{termin.data.title}</h3>
              <p>{termin.data.subtitle}</p>
            </div>
          </a>
        ))}
      </div>

      <h2>Vergangene Veranstaltungen</h2>
      <ul>
        <li><a href="/archiv">Rückblicke &amp; Berichte aus dem Jahr 2025</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
