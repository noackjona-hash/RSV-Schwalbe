---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allTermine = await getCollection('veranstaltungen');
const sortedTermine = allTermine.sort((a, b) => a.data.date.localeCompare(b.data.date));
---

<BaseLayout title="Veranstaltungen | RSV Schwalbe Ellmendingen">
  <div class="page-body">
    <div class="container">
      <h1>Veranstaltungen &amp; Termine</h1>
      <p>Hier findest du alle anstehenden Vereinsveranstaltungen, Renntermine und Feste des RSV &ldquo;Schwalbe&rdquo; Ellmendingen e.&thinsp;V.</p>

      <h2>Termine 2026</h2>
      <div class="termine-grid" style="margin: 1.5rem 0 2.5rem; max-width: none;">
        {sortedTermine.map((termin) => (
          <a href={termin.data.detailUrl} class="termin-card">
            <div>
              <span class="termin-kicker">
                {termin.data.highlight ? 'Radrennen · Highlight' : 'Veranstaltung'}
              </span>
              <h3>{termin.data.title}</h3>
            </div>
            <div class="termin-meta-row">
              <span class="termin-meta-item">
                <svg class="termin-meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                {termin.data.date}
              </span>
              <span class="termin-meta-item">
                <svg class="termin-meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                {termin.data.subtitle}
              </span>
            </div>
          </a>
        ))}
      </div>

      <h2>Vergangene Veranstaltungen</h2>
      <ul class="links-list">
        <li><a href="/archiv">Rückblicke &amp; Berichte aus dem Jahr 2025 <span>&rarr;</span></a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
